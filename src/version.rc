#include <winver.h>
#include "version.h"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION YTV_VERSION_RC
 PRODUCTVERSION YTV_VERSION_RC
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Roger Sacchelli"
      VALUE "FileDescription", "YANG Tree View - Notepad++ plugin"
      VALUE "FileVersion", YTV_VERSION_RC_STR
      VALUE "LegalCopyright", "Copyright (C) 2026 Roger Sacchelli. GPL-3.0"
      VALUE "ProductName", "YANG Tree View"
      VALUE "ProductVersion", YTV_VERSION_RC_STR
      VALUE "InternalName", "YangTreeView"
      VALUE "OriginalFilename", "YangTreeView.dll"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
